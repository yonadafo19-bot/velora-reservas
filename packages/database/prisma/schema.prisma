generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessVertical {
  BARBERSHOP
  BEAUTY_STUDIO
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LoyaltyTier {
  STANDARD
  PREFERRED
  VIP
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOffStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC_WEB
  ADMIN
  WHATSAPP
  SYSTEM
}

enum AppointmentSegmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CancellationSource {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum WaitlistStatus {
  OPEN
  MATCHED
  CONTACTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum WaitlistSource {
  PUBLIC_WEB
  ADMIN
  WHATSAPP
  SYSTEM
}

enum ReleasedSlotStatus {
  OPEN
  RESERVED
  EXPIRED
  CLOSED
}

enum ReleasedSlotSource {
  CANCELLATION
  RESCHEDULE
  ADMIN
  SYSTEM
}

enum ReleasedSlotCandidateStatus {
  SUGGESTED
  CONTACTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DepositPolicyType {
  FIXED_CLP
  PERCENTAGE
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductRecommendationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductInquiryChannel {
  PUBLIC_WEB
  ADMIN
  WHATSAPP
  SYSTEM
}

enum ProductInquiryStatus {
  OPEN
  CONTACTED
  CLOSED
  CANCELLED
}

enum RetailOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum RetailOrderSource {
  ADMIN
  APPOINTMENT
  WHATSAPP
  SYSTEM
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ResourceTypeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ActorType {
  CUSTOMER
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
  SYSTEM
}

enum AuditEntityType {
  BUSINESS
  LOCATION
  USER
  MEMBERSHIP
  CUSTOMER
  SERVICE_CATEGORY
  SERVICE
  SERVICE_ADDON
  PROFESSIONAL
  PROFESSIONAL_LOCATION
  PROFESSIONAL_SERVICE
  PACK
  PACK_ITEM
  BUSINESS_HOUR
  PROFESSIONAL_AVAILABILITY_RULE
  TIME_OFF
  APPOINTMENT
  APPOINTMENT_SERVICE
  APPOINTMENT_SEGMENT
  WAITLIST_ENTRY
  WAITLIST_SERVICE
  RELEASED_SLOT
  RELEASED_SLOT_CANDIDATE
  DEPOSIT_POLICY
  NO_SHOW_POLICY
  PRODUCT_CATEGORY
  PRODUCT
  PRODUCT_INVENTORY
  PRODUCT_RECOMMENDATION
  PRODUCT_INQUIRY
  RETAIL_ORDER
  RETAIL_ORDER_ITEM
  RESOURCE_TYPE
  RESOURCE
  SERVICE_RESOURCE_REQUIREMENT
  INVENTORY_MOVEMENT
}

enum AuditAction {
  CREATED
  UPDATED
  ARCHIVED
  DEACTIVATED
  CANCELLED
  RESCHEDULED
  CONFIRMED
  COMPLETED
  MARKED_NO_SHOW
  SERVICE_ADDED
  SERVICE_REMOVED
  PROFESSIONAL_CHANGED
  WAITLIST_JOINED
  WAITLIST_MATCHED
  WAITLIST_CONTACTED
  WAITLIST_CONVERTED
  SLOT_RELEASED
  SLOT_RESERVED
  WHATSAPP_CLICKED
  CALENDAR_EXPORTED
  VIP_LEVEL_CHANGED
  STOCK_ADJUSTED
  INVENTORY_MOVED
  PRODUCT_INQUIRY_CREATED
  RETAIL_ORDER_CREATED
  POLICY_CHANGED
  RESOURCE_CHANGED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  STOCK_ADJUSTMENT
  RESERVED
  RELEASED
  SOLD
  CANCELLED
  CORRECTION
}

enum InventoryReferenceType {
  APPOINTMENT
  RETAIL_ORDER
  RETAIL_ORDER_ITEM
  PRODUCT_INQUIRY
  ADMIN
  SYSTEM
}

model Business {
  id                    String           @id @default(cuid())
  slug                  String           @unique @db.VarChar(100)
  name                  String           @db.VarChar(160)
  vertical              BusinessVertical
  timezone              String           @default("America/Santiago") @db.VarChar(64)
  currency              String           @default("CLP") @db.VarChar(3)
  status                BusinessStatus   @default(ACTIVE)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  defaultNoShowPolicyId String?

  locations                     Location[]
  memberships                   Membership[]
  customers                     Customer[]
  serviceCategories             ServiceCategory[]
  services                      Service[]
  serviceAddons                 ServiceAddon[]
  professionals                 Professional[]
  professionalLocations         ProfessionalLocation[]
  professionalServices          ProfessionalService[]
  packs                         Pack[]
  packItems                     PackItem[]
  businessHours                 BusinessHour[]
  professionalAvailabilityRules ProfessionalAvailabilityRule[]
  timeOffEntries                TimeOff[]
  appointments                  Appointment[]
  appointmentServices           AppointmentService[]
  appointmentSegments           AppointmentSegment[]
  waitlistEntries               WaitlistEntry[]
  waitlistServices              WaitlistService[]
  releasedSlots                 ReleasedSlot[]
  releasedSlotCandidates        ReleasedSlotCandidate[]
  depositPolicies               DepositPolicy[]
  noShowPolicies                NoShowPolicy[]                 @relation("BusinessNoShowPolicies")
  defaultNoShowPolicy           NoShowPolicy?                  @relation("BusinessDefaultNoShowPolicy", fields: [id, defaultNoShowPolicyId], references: [businessId, id], onDelete: Restrict)
  productCategories             ProductCategory[]
  products                      Product[]
  productInventories            ProductInventory[]
  productRecommendations        ProductRecommendation[]
  productInquiries              ProductInquiry[]
  retailOrders                  RetailOrder[]
  retailOrderItems              RetailOrderItem[]
  resourceTypes                 ResourceType[]
  resources                     Resource[]
  serviceResourceRequirements   ServiceResourceRequirement[]
  auditLogs                     AuditLog[]
  appointmentStatusHistory      AppointmentStatusHistory[]
  inventoryMovements            InventoryMovement[]

  @@index([status])
}

model Location {
  id            String         @id @default(cuid())
  businessId    String
  slug          String         @db.VarChar(100)
  name          String         @db.VarChar(160)
  addressLine   String?        @db.VarChar(240)
  city          String?        @db.VarChar(120)
  region        String?        @db.VarChar(120)
  timezone      String?        @db.VarChar(64)
  phone         String?        @db.VarChar(32)
  whatsappPhone String?        @db.VarChar(32)
  status        LocationStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  professionalLocations         ProfessionalLocation[]
  businessHours                 BusinessHour[]
  professionalAvailabilityRules ProfessionalAvailabilityRule[]
  timeOffEntries                TimeOff[]
  appointments                  Appointment[]
  appointmentSegments           AppointmentSegment[]
  waitlistEntries               WaitlistEntry[]
  releasedSlots                 ReleasedSlot[]
  productInventories            ProductInventory[]
  productInquiries              ProductInquiry[]
  retailOrders                  RetailOrder[]
  resources                     Resource[]
  auditLogs                     AuditLog[]
  inventoryMovements            InventoryMovement[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status])
}

model User {
  id          String     @id @default(cuid())
  authSubject String     @unique @db.VarChar(160)
  email       String     @unique @db.VarChar(320)
  displayName String?    @db.VarChar(160)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  memberships Membership[]

  @@index([status])
}

model Membership {
  id         String           @id @default(cuid())
  businessId String
  userId     String
  role       MembershipRole
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([businessId, role, status])
  @@index([userId, status])
}

model Customer {
  id               String      @id @default(cuid())
  businessId       String
  firstName        String      @db.VarChar(120)
  lastName         String?     @db.VarChar(120)
  phone            String      @db.VarChar(32)
  email            String?     @db.VarChar(320)
  loyaltyTier      LoyaltyTier @default(STANDARD)
  priorityScore    Int         @default(0)
  isManualVip      Boolean     @default(false)
  preferencesNotes String?     @db.Text
  internalNotes    String?     @db.Text
  firstVisitAt     DateTime?   @db.Timestamptz(3)
  lastVisitAt      DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  productInquiries ProductInquiry[]
  retailOrders     RetailOrder[]

  @@unique([businessId, id])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, loyaltyTier])
}

model ServiceCategory {
  id          String        @id @default(cuid())
  businessId  String
  name        String        @db.VarChar(160)
  slug        String        @db.VarChar(100)
  description String?       @db.Text
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status, sortOrder])
}

model Service {
  id                  String        @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String        @db.VarChar(160)
  slug                String        @db.VarChar(100)
  description         String?       @db.Text
  basePriceClp        Int
  durationMinutes     Int
  bufferBeforeMinutes Int           @default(0)
  bufferAfterMinutes  Int           @default(0)
  status              CatalogStatus @default(ACTIVE)
  isMainService       Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  depositPolicyId     String?

  business               Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category               ServiceCategory?             @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  baseServiceAddons      ServiceAddon[]               @relation("BaseServiceAddons")
  addonServiceAddons     ServiceAddon[]               @relation("AddonServiceAddons")
  professionalServices   ProfessionalService[]
  packItems              PackItem[]
  appointmentServices    AppointmentService[]
  waitlistServices       WaitlistService[]
  depositPolicy          DepositPolicy?               @relation(fields: [businessId, depositPolicyId], references: [businessId, id], onDelete: Restrict)
  productRecommendations ProductRecommendation[]
  productInquiries       ProductInquiry[]
  resourceRequirements   ServiceResourceRequirement[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, categoryId, status, sortOrder])
  @@index([businessId, isMainService, status, sortOrder])
  @@index([businessId, depositPolicyId])
}

model ServiceAddon {
  id             String        @id @default(cuid())
  businessId     String
  baseServiceId  String
  addonServiceId String
  sortOrder      Int           @default(0)
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  baseService  Service  @relation("BaseServiceAddons", fields: [businessId, baseServiceId], references: [businessId, id], onDelete: Restrict)
  addonService Service  @relation("AddonServiceAddons", fields: [businessId, addonServiceId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, baseServiceId, addonServiceId])
  @@index([businessId, baseServiceId, status, sortOrder])
  @@index([businessId, addonServiceId])
}

model Professional {
  id          String             @id @default(cuid())
  businessId  String
  displayName String             @db.VarChar(160)
  slug        String             @db.VarChar(100)
  roleTitle   String?            @db.VarChar(160)
  bio         String?            @db.Text
  phone       String?            @db.VarChar(32)
  email       String?            @db.VarChar(320)
  status      ProfessionalStatus @default(ACTIVE)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  business                 Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  locations                ProfessionalLocation[]
  services                 ProfessionalService[]
  availabilityRules        ProfessionalAvailabilityRule[]
  timeOffEntries           TimeOff[]
  appointmentSegments      AppointmentSegment[]
  preferredWaitlistEntries WaitlistEntry[]
  releasedSlots            ReleasedSlot[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status, sortOrder])
}

model ProfessionalLocation {
  id             String             @id @default(cuid())
  businessId     String
  professionalId String
  locationId     String
  status         AvailabilityStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  location     Location     @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, professionalId, locationId])
  @@index([businessId, locationId, status])
  @@index([businessId, professionalId, status])
}

model ProfessionalService {
  id                    String             @id @default(cuid())
  businessId            String
  professionalId        String
  serviceId             String
  customPriceClp        Int?
  customDurationMinutes Int?
  status                AvailabilityStatus @default(ACTIVE)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  service      Service      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, professionalId, serviceId])
  @@index([businessId, serviceId, status])
  @@index([businessId, professionalId, status])
}

model Pack {
  id              String        @id @default(cuid())
  businessId      String
  name            String        @db.VarChar(160)
  slug            String        @db.VarChar(100)
  description     String?       @db.Text
  priceClp        Int
  status          CatalogStatus @default(ACTIVE)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  depositPolicyId String?

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items               PackItem[]
  appointmentServices AppointmentService[]
  waitlistServices    WaitlistService[]
  depositPolicy       DepositPolicy?       @relation(fields: [businessId, depositPolicyId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status, sortOrder])
  @@index([businessId, depositPolicyId])
}

model PackItem {
  id         String   @id @default(cuid())
  businessId String
  packId     String
  serviceId  String
  sequence   Int
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  pack     Pack     @relation(fields: [businessId, packId], references: [businessId, id], onDelete: Restrict)
  service  Service  @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, packId, serviceId, sequence])
  @@index([businessId, packId, sequence])
  @@index([businessId, serviceId])
}

model BusinessHour {
  id            String             @id @default(cuid())
  businessId    String
  locationId    String?
  weekday       Weekday
  opensAtLocal  String             @db.VarChar(5)
  closesAtLocal String             @db.VarChar(5)
  status        AvailabilityStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location? @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, locationId, weekday, status])
}

model ProfessionalAvailabilityRule {
  id             String             @id @default(cuid())
  businessId     String
  professionalId String
  locationId     String
  weekday        Weekday
  startsAtLocal  String             @db.VarChar(5)
  endsAtLocal    String             @db.VarChar(5)
  status         AvailabilityStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  location     Location     @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, professionalId, locationId, weekday, status])
  @@index([businessId, locationId, weekday, status])
}

model TimeOff {
  id             String        @id @default(cuid())
  businessId     String
  professionalId String?
  locationId     String?
  startsAt       DateTime      @db.Timestamptz(3)
  endsAt         DateTime      @db.Timestamptz(3)
  reason         String?       @db.VarChar(500)
  status         TimeOffStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  professional Professional? @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  location     Location?     @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, startsAt, endsAt, status])
  @@index([businessId, professionalId, startsAt])
  @@index([businessId, locationId, startsAt])
}

model Appointment {
  id                        String              @id @default(cuid())
  businessId                String
  locationId                String
  customerId                String
  status                    AppointmentStatus   @default(PENDING)
  source                    AppointmentSource
  startAt                   DateTime            @db.Timestamptz(3)
  endAt                     DateTime            @db.Timestamptz(3)
  totalPriceClp             Int
  totalDurationMinutes      Int
  currencySnapshot          String              @default("CLP") @db.VarChar(3)
  timezoneSnapshot          String              @default("America/Santiago") @db.VarChar(64)
  bookingRequestId          String?             @db.VarChar(128)
  publicTokenHash           String?             @unique @db.VarChar(128)
  customerNotes             String?             @db.Text
  internalNotes             String?             @db.Text
  isFirstVisit              Boolean             @default(false)
  cancelledAt               DateTime?           @db.Timestamptz(3)
  cancellationReason        String?             @db.VarChar(500)
  cancellationSource        CancellationSource?
  isLateCancellation        Boolean             @default(false)
  markedNoShowAt            DateTime?           @db.Timestamptz(3)
  depositRequiredSnapshot   Boolean             @default(false)
  depositPolicySnapshotJson Json?
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)

  business                 Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location                 Location                   @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  customer                 Customer                   @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  services                 AppointmentService[]
  segments                 AppointmentSegment[]
  convertedWaitlistEntries WaitlistEntry[]
  releasedSlots            ReleasedSlot[]
  productInquiries         ProductInquiry[]
  retailOrders             RetailOrder[]
  statusHistory            AppointmentStatusHistory[]

  @@unique([businessId, bookingRequestId])
  @@unique([businessId, id])
  @@unique([businessId, id, locationId])
  @@index([businessId, locationId, status, startAt])
  @@index([businessId, customerId, startAt])
  @@index([businessId, status, startAt, endAt])
}

model AppointmentService {
  id                             String   @id @default(cuid())
  businessId                     String
  appointmentId                  String
  serviceId                      String?
  packId                         String?
  sequence                       Int
  serviceNameSnapshot            String   @db.VarChar(160)
  servicePriceClpSnapshot        Int
  serviceDurationMinutesSnapshot Int
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime @updatedAt @db.Timestamptz(3)

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment          @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  service     Service?             @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  pack        Pack?                @relation(fields: [businessId, packId], references: [businessId, id], onDelete: Restrict)
  segments    AppointmentSegment[]

  @@unique([businessId, appointmentId, sequence])
  @@unique([businessId, appointmentId, id])
  @@index([businessId, serviceId])
  @@index([businessId, packId])
}

model AppointmentSegment {
  id                   String                   @id @default(cuid())
  businessId           String
  appointmentId        String
  appointmentServiceId String
  professionalId       String
  locationId           String
  sequence             Int
  startsAt             DateTime                 @db.Timestamptz(3)
  endsAt               DateTime                 @db.Timestamptz(3)
  blocksAvailability   Boolean                  @default(true)
  status               AppointmentSegmentStatus @default(SCHEDULED)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment        Appointment        @relation(fields: [businessId, appointmentId, locationId], references: [businessId, id, locationId], onDelete: Restrict)
  appointmentService AppointmentService @relation(fields: [businessId, appointmentId, appointmentServiceId], references: [businessId, appointmentId, id], onDelete: Restrict)
  professional       Professional       @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  location           Location           @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  releasedSlots      ReleasedSlot[]

  @@unique([businessId, appointmentId, sequence])
  @@unique([businessId, id])
  @@index([businessId, professionalId, startsAt, endsAt, status])
  @@index([businessId, locationId, startsAt, status])
  @@index([businessId, appointmentServiceId, sequence])
}

model WaitlistEntry {
  id                      String         @id @default(cuid())
  businessId              String
  locationId              String
  customerId              String?
  status                  WaitlistStatus @default(OPEN)
  source                  WaitlistSource
  desiredDateLocal        DateTime?      @db.Date
  desiredStartTimeLocal   String?        @db.VarChar(5)
  desiredEndTimeLocal     String?        @db.VarChar(5)
  preferredProfessionalId String?
  acceptsAnyProfessional  Boolean        @default(true)
  acceptsSplitServices    Boolean        @default(false)
  maxWaitMinutes          Int?
  priorityScore           Int            @default(0)
  customerNameSnapshot    String         @db.VarChar(160)
  customerPhoneSnapshot   String         @db.VarChar(32)
  customerEmailSnapshot   String?        @db.VarChar(320)
  notes                   String?        @db.Text
  expiresAt               DateTime?      @db.Timestamptz(3)
  convertedAppointmentId  String?
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(3)

  business              Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location              Location                @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  customer              Customer?               @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  preferredProfessional Professional?           @relation(fields: [businessId, preferredProfessionalId], references: [businessId, id], onDelete: Restrict)
  convertedAppointment  Appointment?            @relation(fields: [businessId, convertedAppointmentId], references: [businessId, id], onDelete: Restrict)
  services              WaitlistService[]
  candidates            ReleasedSlotCandidate[]

  @@unique([businessId, id])
  @@index([businessId, locationId, status, desiredDateLocal])
  @@index([businessId, customerId, status])
  @@index([businessId, preferredProfessionalId, status, desiredDateLocal])
  @@index([businessId, expiresAt, status])
  @@index([businessId, convertedAppointmentId])
}

model WaitlistService {
  id                             String   @id @default(cuid())
  businessId                     String
  waitlistEntryId                String
  serviceId                      String?
  packId                         String?
  sequence                       Int
  serviceNameSnapshot            String   @db.VarChar(160)
  servicePriceClpSnapshot        Int
  serviceDurationMinutesSnapshot Int
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime @updatedAt @db.Timestamptz(3)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  waitlistEntry WaitlistEntry @relation(fields: [businessId, waitlistEntryId], references: [businessId, id], onDelete: Restrict)
  service       Service?      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  pack          Pack?         @relation(fields: [businessId, packId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, waitlistEntryId, sequence])
  @@index([businessId, serviceId])
  @@index([businessId, packId])
}

model ReleasedSlot {
  id                   String             @id @default(cuid())
  businessId           String
  locationId           String
  appointmentId        String?
  appointmentSegmentId String?
  professionalId       String
  startsAt             DateTime           @db.Timestamptz(3)
  endsAt               DateTime           @db.Timestamptz(3)
  status               ReleasedSlotStatus @default(OPEN)
  source               ReleasedSlotSource
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location           Location                @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  appointment        Appointment?            @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  appointmentSegment AppointmentSegment?     @relation(fields: [businessId, appointmentSegmentId], references: [businessId, id], onDelete: Restrict)
  professional       Professional            @relation(fields: [businessId, professionalId], references: [businessId, id], onDelete: Restrict)
  candidates         ReleasedSlotCandidate[]

  @@unique([businessId, id])
  @@index([businessId, locationId, status, startsAt])
  @@index([businessId, professionalId, status, startsAt])
  @@index([businessId, appointmentId])
  @@index([businessId, appointmentSegmentId])
}

model ReleasedSlotCandidate {
  id              String                      @id @default(cuid())
  businessId      String
  releasedSlotId  String
  waitlistEntryId String
  score           Int
  reason          String?                     @db.VarChar(500)
  status          ReleasedSlotCandidateStatus @default(SUGGESTED)
  contactedAt     DateTime?                   @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  releasedSlot  ReleasedSlot  @relation(fields: [businessId, releasedSlotId], references: [businessId, id], onDelete: Restrict)
  waitlistEntry WaitlistEntry @relation(fields: [businessId, waitlistEntryId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, releasedSlotId, waitlistEntryId])
  @@index([businessId, releasedSlotId, status, score])
  @@index([businessId, waitlistEntryId, status])
}

model DepositPolicy {
  id                    String            @id @default(cuid())
  businessId            String
  name                  String            @db.VarChar(160)
  type                  DepositPolicyType
  fixedAmountClp        Int?
  percentageBasisPoints Int?
  status                PolicyStatus      @default(ACTIVE)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]
  packs    Pack[]

  @@unique([businessId, id])
  @@index([businessId, status, type])
}

model NoShowPolicy {
  id                            String       @id @default(cuid())
  businessId                    String
  name                          String       @db.VarChar(160)
  lateCancellationWindowMinutes Int
  trackNoShow                   Boolean      @default(true)
  status                        PolicyStatus @default(ACTIVE)
  createdAt                     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime     @updatedAt @db.Timestamptz(3)

  business           Business   @relation("BusinessNoShowPolicies", fields: [businessId], references: [id], onDelete: Restrict)
  defaultForBusiness Business[] @relation("BusinessDefaultNoShowPolicy")

  @@unique([businessId, id])
  @@index([businessId, status])
}

model ProductCategory {
  id          String        @id @default(cuid())
  businessId  String
  name        String        @db.VarChar(160)
  slug        String        @db.VarChar(100)
  description String?       @db.Text
  sortOrder   Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status, sortOrder])
}

model Product {
  id              String        @id @default(cuid())
  businessId      String
  categoryId      String?
  sku             String?       @db.VarChar(100)
  name            String        @db.VarChar(160)
  slug            String        @db.VarChar(100)
  description     String?       @db.Text
  priceClp        Int
  imageUrl        String?       @db.VarChar(2048)
  tracksInventory Boolean       @default(true)
  status          ProductStatus @default(ACTIVE)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category           ProductCategory?        @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  inventories        ProductInventory[]
  recommendations    ProductRecommendation[]
  inquiries          ProductInquiry[]
  retailOrderItems   RetailOrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([businessId, slug])
  @@unique([businessId, sku])
  @@unique([businessId, id])
  @@index([businessId, categoryId, status, sortOrder])
}

model ProductInventory {
  id           String   @id @default(cuid())
  businessId   String
  productId    String
  locationId   String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  reorderPoint Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product   Product             @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  location  Location            @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  movements InventoryMovement[]

  @@unique([businessId, productId, locationId])
  @@unique([businessId, id, productId, locationId])
  @@index([businessId, locationId, productId])
  @@index([businessId, locationId, reorderPoint])
}

model ProductRecommendation {
  id         String                      @id @default(cuid())
  businessId String
  serviceId  String
  productId  String
  priority   Int                         @default(0)
  message    String?                     @db.VarChar(500)
  status     ProductRecommendationStatus @default(ACTIVE)
  createdAt  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                    @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  product  Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, serviceId, productId])
  @@index([businessId, serviceId, status, priority])
  @@index([businessId, productId, status])
}

model ProductInquiry {
  id                    String                @id @default(cuid())
  businessId            String
  locationId            String?
  productId             String
  serviceId             String?
  appointmentId         String?
  customerId            String?
  channel               ProductInquiryChannel
  customerNameSnapshot  String?               @db.VarChar(160)
  customerPhoneSnapshot String?               @db.VarChar(32)
  message               String?               @db.Text
  status                ProductInquiryStatus  @default(OPEN)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location    Location?    @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  product     Product      @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  service     Service?     @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, productId, status, createdAt])
  @@index([businessId, locationId, status, createdAt])
  @@index([businessId, appointmentId])
  @@index([businessId, customerId, createdAt])
}

model RetailOrder {
  id                    String            @id @default(cuid())
  businessId            String
  locationId            String
  customerId            String?
  appointmentId         String?
  status                RetailOrderStatus @default(DRAFT)
  source                RetailOrderSource
  totalClp              Int               @default(0)
  currencySnapshot      String            @default("CLP") @db.VarChar(3)
  customerNameSnapshot  String?           @db.VarChar(160)
  customerPhoneSnapshot String?           @db.VarChar(32)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location    Location          @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  customer    Customer?         @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  appointment Appointment?      @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  items       RetailOrderItem[]

  @@unique([businessId, id])
  @@index([businessId, locationId, status, createdAt])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, appointmentId])
}

model RetailOrderItem {
  id                   String   @id @default(cuid())
  businessId           String
  retailOrderId        String
  productId            String?
  sequence             Int
  productNameSnapshot  String   @db.VarChar(160)
  productSkuSnapshot   String?  @db.VarChar(100)
  unitPriceClpSnapshot Int
  quantity             Int
  totalClpSnapshot     Int
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  retailOrder RetailOrder @relation(fields: [businessId, retailOrderId], references: [businessId, id], onDelete: Restrict)
  product     Product?    @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, retailOrderId, sequence])
  @@index([businessId, productId])
}

model ResourceType {
  id          String             @id @default(cuid())
  businessId  String
  name        String             @db.VarChar(160)
  slug        String             @db.VarChar(100)
  description String?            @db.Text
  status      ResourceTypeStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  business     Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resources    Resource[]
  requirements ServiceResourceRequirement[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, status])
}

model Resource {
  id             String         @id @default(cuid())
  businessId     String
  locationId     String
  resourceTypeId String
  name           String         @db.VarChar(160)
  slug           String         @db.VarChar(100)
  capacity       Int            @default(1)
  status         ResourceStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)
  resourceType ResourceType @relation(fields: [businessId, resourceTypeId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, locationId, slug])
  @@index([businessId, locationId, status])
  @@index([businessId, resourceTypeId, status])
}

model ServiceResourceRequirement {
  id             String   @id @default(cuid())
  businessId     String
  serviceId      String
  resourceTypeId String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  resourceType ResourceType @relation(fields: [businessId, resourceTypeId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, serviceId, resourceTypeId])
  @@index([businessId, resourceTypeId])
}

model AuditLog {
  id           String          @id @default(cuid())
  businessId   String
  locationId   String?
  actorType    ActorType
  actorId      String?         @db.VarChar(128)
  entityType   AuditEntityType
  entityId     String          @db.VarChar(128)
  action       AuditAction
  beforeJson   Json?           @db.JsonB
  afterJson    Json?           @db.JsonB
  metadataJson Json?           @db.JsonB
  ipAddress    String?         @db.VarChar(64)
  userAgent    String?         @db.VarChar(512)
  requestId    String?         @db.VarChar(128)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location? @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, actorType, actorId])
  @@index([businessId, requestId])
  @@index([businessId, locationId, createdAt])
}

model AppointmentStatusHistory {
  id             String             @id @default(cuid())
  businessId     String
  appointmentId  String
  previousStatus AppointmentStatus?
  nextStatus     AppointmentStatus
  reason         String?            @db.VarChar(500)
  actorType      ActorType
  actorId        String?            @db.VarChar(128)
  requestId      String?            @db.VarChar(128)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, appointmentId, createdAt])
  @@index([businessId, requestId])
}

model InventoryMovement {
  id                 String                  @id @default(cuid())
  businessId         String
  productInventoryId String
  productId          String
  locationId         String
  movementType       InventoryMovementType
  delta              Int
  previousOnHand     Int
  nextOnHand         Int
  previousReserved   Int
  nextReserved       Int
  reason             String?                 @db.VarChar(500)
  referenceType      InventoryReferenceType?
  referenceId        String?                 @db.VarChar(128)
  actorType          ActorType
  actorId            String?                 @db.VarChar(128)
  idempotencyKey     String?                 @db.VarChar(128)
  requestId          String?                 @db.VarChar(128)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productInventory ProductInventory @relation(fields: [businessId, productInventoryId, productId, locationId], references: [businessId, id, productId, locationId], onDelete: Restrict)
  product          Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  location         Location         @relation(fields: [businessId, locationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, productInventoryId, createdAt])
  @@index([businessId, productId, locationId, createdAt])
  @@index([businessId, referenceType, referenceId])
  @@index([businessId, requestId])
}
