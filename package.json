{
  "name": "velora-reservas-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @velora/web dev",
    "dev:api": "pnpm --filter @velora/api dev",
    "dev:web": "pnpm --filter @velora/web dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @velora/web start",
    "start:api": "pnpm --filter @velora/api start",
    "start:web": "pnpm --filter @velora/web start",
    "db:format": "pnpm --filter @velora/database prisma:format",
    "db:validate": "pnpm --filter @velora/database prisma:validate",
    "db:generate": "pnpm --filter @velora/database prisma:generate",
    "db:migrate": "pnpm --filter @velora/database prisma:migrate",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "next": "16.2.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1"
  }
}
